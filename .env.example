# Copie este arquivo para .env (que não é versionado) e ajuste os valores.
#   cp .env.example .env

# PostgreSQL. Atenção: em um volume já existente, a senha definida na primeira
# inicialização continua valendo; alterar este valor depois não muda a senha do banco.
POSTGRES_DB=servicehub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT: use um valor aleatório com pelo menos 32 caracteres, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRATION=1h

# Administrador criado na primeira inicialização (opcional)
ADMIN_EMAIL=admin@servicehub.com
ADMIN_PASSWORD=troque-esta-senha

# Porta publicada da API no host
API_PORT=8080
